# =====================================================================
# Root .gitignore for the cosmos_hs* research workspace
# Goal: push source/config only; keep checkpoints, data, caches, run
# outputs and logs out of the repo.
# =====================================================================

# ---- Top-level directories that must never be pushed ----------------
# Checkpoints, datasets, HF/torch/triton/uv caches, run outputs (hundreds of GB)
cosmos_storage/
# Ad-hoc smoke-test scripts and their SLURM .out/.log files
_scratch/
# Third-party clone (has its own .git; install from upstream instead)
LIBERO/
# RoboCasa365 simulator clones for cosmos_hs11 (own .git each; robocasa/ also holds ~23 GB of kitchen assets).
# Set up by cosmos_hs11/packages/cosmos3/examples/setup_robocasa365.sh; install from upstream instead.
/robocasa/
/robosuite/
# Upstream NVIDIA/cosmos benchmark assets, unmodified and identical in every
# cosmos*/ copy (~140 MB each). Delete this line if you edit anything in there.
cosmos*/evaluation/

# ---- openpi_hs11 (openpi fork, tracked as a plain directory) ---------
# openpi_hs11/ used to be a nested git clone (its own .git, pushed to
# github.com/hynnsk/openpi), so debug_cos only stored a commit hash for it.
# Converted to a plain directory on 2026-10-22; the old .git was moved to
# ~/openpi_hs11_dotgit_backup. openpi_hs11/.gitignore still applies underneath
# (assets/ allowlist, caches, ...); the big folders are listed here as well so
# they never depend on that file.
# 1.7 TB of training checkpoints
openpi_hs11/checkpoints/
# 7.9 GB uv virtualenv
openpi_hs11/.venv/
# upstream clones that were openpi submodules (LIBERO 427 MB, aloha 98 MB);
# their .git pointers now live in the backup. Install from upstream instead.
openpi_hs11/third_party/
# W&B run logs, local datasets, test cache
openpi_hs11/wandb/
openpi_hs11/data/
openpi_hs11/.pytest_cache/

# ---- Secrets ---------------------------------------------------------
wandb_api
**/env.sh
.env
.env.*
*.key
*.pem

# ---- Training / eval outputs inside each cosmos_hs*/ -----------------
# e.g. cosmos_hs10/packages/cosmos3/outputs/  (144 GB)
**/outputs/
**/output/
**/checkpoints/
**/ckpt/
**/ckpts/
**/runs/
**/results/
**/wandb/
**/tensorboard/
**/tb_logs/
**/lightning_logs/

# ---- Logs -----------------------------------------------------------
**/logs/
**/log/
*.log
*.out
*.err
*.srun.log
slurm-*.out
nohup.out

# ---- Model weights / tensors / large data files ----------------------
*.pt
*.pth
*.ckpt
*.safetensors
*.distcp
*.bin
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.pickle
*.parquet
*.arrow
*.tar
*.tar.gz
*.tgz
*.zip
*.7z

# ---- Media (example videos in cookbooks/**/assets are ~130 MB per copy) ----
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.gif

# ---- Python / tooling caches -----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
.venv/
venv/
env/
.python-version.local

# ---- Compiled / kernel caches ---------------------------------------
.triton/
.torch/
.cache/
*.cubin
*.ptx

# ---- Editors / OS ---------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Temp -----------------------------------------------------------
tmp/
temp/
*.tmp
*.temp
core.[0-9]*

# ---- Paper draft (CVPR LaTeX project), kept local only -------------
Paper/
